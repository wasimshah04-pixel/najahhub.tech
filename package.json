{
  "name": "sanhi-shop",
  "version": "1.0.0",
  "description": "Shopify Dawn-inspired clothing e-commerce platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server.js",
    "seed": "node server/config/seed.js",
    "import:sanhi": "node server/scripts/import_sanhi_clean.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "better-sqlite3": "^11.3.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "vite": "^5.4.8",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "concurrently": "^9.0.1",
    "@fontsource/poppins": "^5.1.0"
  }
}
